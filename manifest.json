{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "4.0.0",
  "description": "__MSG_appDesc__",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icons/glasstab-16.png",
    "32": "icons/glasstab-32.png",
    "48": "icons/glasstab-48.png",
    "128": "icons/glasstab-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "tab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "GlassTab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/glasstab-16.png",
      "32": "icons/glasstab-32.png",
      "48": "icons/glasstab-48.png",
      "128": "icons/glasstab-128.png"
    }
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: http: data: blob:; img-src 'self' https: http: data: blob:; style-src 'self' 'unsafe-inline';"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab",
    "scripting",
    "contextMenus",
    "favicon"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "optional_permissions": [
    "history"
  ]
}
